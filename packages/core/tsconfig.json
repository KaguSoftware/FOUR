{
  "compilerOptions": {
    "target": "ES2022",
    // No "dom" lib, on purpose. This package must stay renderer-agnostic so the
    // same engine runs under Next.js and under Hermes. Reaching for `document`
    // or `window` in here should be a compile error, not a code review catch.
    "lib": ["ES2022"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "skipLibCheck": true
  },
  "include": ["**/*.ts"],
  "exclude": ["node_modules"]
}
