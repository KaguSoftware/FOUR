# Copy to apps/mobile/.env.local and fill in. That file is gitignored.
#
# Names match apps/web's, minus the framework prefix, so there is one convention
# across the monorepo rather than two.
#
# EXPO_PUBLIC_ variables are INLINED INTO THE BUNDLE at build time and are
# readable by anyone who downloads the app. That is correct for both of these —
# the publishable key is designed to be public, and RLS (auth.uid() = user_id,
# on all eight tables) is what actually protects the data.
#
# The SERVICE ROLE key must NEVER appear here. It bypasses RLS entirely; it
# belongs only to the monitor route on the server.

EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_<...>

# Native Google Sign-In on ANDROID (Credential Manager). Optional: unset, the
# app falls back to the browser round trip, which works on both platforms.
#
# This is the **Web** client ID from Google Cloud — the one whose type reads
# "Web application" — NOT the Android one. Android's own OAuth client is
# matched by package name (`com.kagusoftware.uptime`) plus the SHA-1 of the
# signing certificate and is never named in code; the Web client is the
# audience the returned idToken is minted for, and it is the value Supabase's
# Google provider must list under "Authorized Client IDs".
#
# Using the Android client ID here fails with `DEVELOPER_ERROR`, which says
# nothing about which of the two is wrong. It is also public by design — a
# client ID is an identifier, not a secret — so EXPO_PUBLIC_ is correct.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=<...>.apps.googleusercontent.com
