{
  "name": "uptime-app",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @uptime/web",
    "build": "npm run build -w @uptime/web",
    "start": "npm run start -w @uptime/web",
    "lint": "npm run lint -w @uptime/web",
    "test": "npm run test -w @uptime/core",
    "test:watch": "npm run test:watch -w @uptime/core",
    "typecheck": "npm run typecheck -w @uptime/core && npm run typecheck -w @uptime/web",
    "seed": "node scripts/seed.mjs",
    "reset": "node scripts/reset-account.mjs",
    "shoot": "node scripts/shoot.mjs",
    "test:migrations": "node scripts/test-migrations.mjs",
    "check:contrast": "node scripts/check-contrast.mjs"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.11",
    "@supabase/supabase-js": "^2.110.7",
    "playwright": "^1.61.1",
    "typescript": "^5"
  }
}
