# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.
#
# Monorepo note: patterns here are deliberately NOT anchored with a leading "/".
# Build output and dependencies now live under apps/* and packages/*, so a
# root-anchored "/node_modules" would silently stop ignoring apps/web/.next.

# dependencies
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
coverage/

# next.js
.next/
out/

# production
build/
dist/

# expo / react native
.expo/
.expo-shared/
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.orig.*

# native build output (apps/mobile — generated by prebuild, not committed)
apps/mobile/ios/
apps/mobile/android/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...except the templates, which carry no secrets and document which variables
# each app needs. `.env*` swallowed them, which made the contract invisible.
!.env.example
!.env*.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local test/dev helpers
scratch/

# Supabase CLI link state. Not secret, but it publishes the project ref and the
# pooler hostname, and this repo is public. Un-anchored so it catches a stray
# copy created by running the CLI from the wrong directory.
.temp/
